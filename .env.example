# Copy to .env and fill in. Never commit .env.
# Local dev runs against docker-compose Postgres/Redis, not Neon.

# Host ports for the docker-compose services. Change these (and the URLs below) if
# 5432 or 6379 are already in use by another project.
POSTGRES_PORT=5432
REDIS_PORT=6379

# The API connects as app_user (created by the first migration).
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/waitlist
# Migrations and the check script connect as the owner role.
DATABASE_URL_MIGRATE=postgresql://waitlist:waitlist@localhost:5432/waitlist
REDIS_URL=redis://localhost:6379

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENC_KEY=

# Leave empty to disable Sentry locally
SENTRY_DSN=
