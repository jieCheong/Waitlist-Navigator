# Copy to .env and fill in. Never commit .env.
# Local dev runs against docker-compose Postgres/Redis, not Neon.
DATABASE_URL=postgresql://waitlist:waitlist@localhost:5432/waitlist
REDIS_URL=redis://localhost:6379

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENC_KEY=

# Leave empty to disable Sentry locally
SENTRY_DSN=
